generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id        String   @id @default(cuid())
  token     String   @unique
  username  String?
  avatarUrl String?
  isActive  Boolean  @default(false)
  status    String   @default("VALID") // VALID, INVALID, BANNED
  proxy     Proxy?
  campaigns Campaign[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proxy {
  id        String   @id @default(cuid())
  address   String
  username  String?
  password  String?
  tokens    Token[]
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  userId    String   @unique
  username  String?
  guildId   String?
  isTarget  Boolean  @default(true)
  sentCount Int      @default(0)
  lastSentAt DateTime?
  campaigns Campaign[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Campaign {
  id            String    @id @default(cuid())
  name          String
  templateId    String?
  message       String
  cooldownMin   Int       @default(5)
  cooldownMax   Int       @default(15)
  useTyping     Boolean   @default(true)
  autoReply     String?
  status        String    @default("IDLE") // IDLE, RUNNING, PAUSED
  tokens        Token[]   @relation(fields: [tokenIds], references: [id])
  tokenIds      String[]
  leads         Lead[]    @relation(fields: [leadIds], references: [id])
  leadIds       String[]
  logs          Log[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Log {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  tokenName  String
  leadId     String
  status     String // SUCCESS, ERROR
  error      String?
  createdAt  DateTime @default(now())
}