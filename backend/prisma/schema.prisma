generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id        String   @id @default(uuid())
  token     String   @unique
  status    String   @default("pending") // pending, valid, invalid
  useProxy  Boolean   @default(false)
  proxy     String?
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

model Lead {
  id           String   @id // O ID do Discord do usuário
  username     String?
  status       String   @default("pending") // pending, sent, blocked
  serverOrigin String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Campaign {
  id        String   @id @default(uuid())
  name      String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
}
